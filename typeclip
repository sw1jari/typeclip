#!/usr/bin/env bash
# types text out as keystrokes after a short delay, for pages that break
# pasting. Without text it types the clipboard. Run it from dmenu or a terminal,
# then click into the field before it fires.
# usage: typeclip [-d seconds] [text]   (delay defaults to 3 or $TYPECLIP_DELAY)

DELAY="${TYPECLIP_DELAY:-3}"
if [ "$1" = "-d" ]; then DELAY="$2"; shift 2; fi

if [ $# -gt 0 ]; then
    text="$*"
else
    text="$(xclip -selection clipboard -o 2>/dev/null)"
fi
if [ -z "$text" ]; then
    dunstify "typeclip" "Nothing to type, the clipboard is empty" 2>/dev/null
    echo "typeclip: nothing to type" >&2
    exit 1
fi

# one notification that updates every second, then closes when typing starts
ID=9341
for ((i = DELAY; i > 0; i--)); do
    dunstify -r "$ID" -t 1500 "typeclip" "Typing ${#text} characters in ${i}s, click the field" 2>/dev/null
    sleep 1
done
dunstify -C "$ID" 2>/dev/null

# xdotool drops newlines from piped text, so press Return between the lines
first=1
while IFS= read -r line || [ -n "$line" ]; do
    [ "$first" = 0 ] && xdotool key --clearmodifiers Return
    first=0
    [ -n "$line" ] && xdotool type --clearmodifiers --delay 12 -- "$line"
done <<< "$text"
