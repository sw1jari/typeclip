#!/usr/bin/env bash
# types the clipboard out as keystrokes after a short delay, for pages that
# break pasting. Run it from dmenu, then click into the field before it fires.
# usage: typeclip [seconds]   (default 3, or $TYPECLIP_DELAY)

DELAY="${1:-${TYPECLIP_DELAY:-3}}"

text="$(xclip -selection clipboard -o 2>/dev/null)"
if [ -z "$text" ]; then
    dunstify "typeclip" "Clipboard is empty" 2>/dev/null
    exit 1
fi

dunstify "typeclip" "Typing ${#text} characters in ${DELAY}s, click the field" 2>/dev/null
sleep "$DELAY"

# xdotool drops newlines from piped text, so press Return between the lines
first=1
while IFS= read -r line || [ -n "$line" ]; do
    [ "$first" = 0 ] && xdotool key --clearmodifiers Return
    first=0
    [ -n "$line" ] && xdotool type --clearmodifiers --delay 12 -- "$line"
done <<< "$text"
